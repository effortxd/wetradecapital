# ─── CLEAN URLs (strip .html extension) ───────────────────────────
RewriteEngine On

# Redirect /page.html → /page (301)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally rewrite /page → /page.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Default to index.html on /
DirectoryIndex index.html

# ─── SECURITY HEADERS ────────────────────────────────────────────
<IfModule mod_headers.c>
    # Block MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Block iframe embedding (anti-clickjacking)
    Header always set X-Frame-Options "DENY"

    # Limit referrer info leak
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Disable risky browser APIs
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # Force HTTPS for 2 years (preload-eligible). Only enable after HTTPS verified working.
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # Cross-origin isolation
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline'; connect-src 'self' https:; frame-ancestors 'none'; form-action 'self' mailto:; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# ─── HTTPS REDIRECT (uncomment after SSL is set up) ──────────────
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── HIDE SENSITIVE FILES ────────────────────────────────────────
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ─── DISABLE DIRECTORY LISTING ───────────────────────────────────
Options -Indexes
